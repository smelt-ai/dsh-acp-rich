{
  "name": "@smelt-ai/dsh-acp-rich",
  "version": "0.1.6",
  "description": "Presentation-complete Agent Client Protocol server for deepseek-harness: streaming text, reasoning, tool cards, inline diffs, plans, usage, commands, permission prompts, and resumable sessions",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/smelt-ai/dsh-acp-rich.git"
  },
  "homepage": "https://github.com/smelt-ai/dsh-acp-rich#readme",
  "bugs": {
    "url": "https://github.com/smelt-ai/dsh-acp-rich/issues"
  },
  "keywords": [
    "acp",
    "agent-client-protocol",
    "deepseek-harness",
    "cordis",
    "smelt"
  ],
  "publishConfig": {
    "access": "public"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./lease": {
      "types": "./lib/lease.d.ts",
      "default": "./lib/lease.js"
    },
    "./capabilities": {
      "types": "./lib/capabilities.d.ts",
      "default": "./lib/capabilities.js"
    },
    "./discovery": {
      "types": "./lib/discovery.d.ts",
      "default": "./lib/discovery.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "bin/dsh-acp-rich.mjs",
    "bin/dsh-credential.mjs",
    "bin/dsh-model-settings.mjs",
    "bin/dsh-model-capabilities.mjs",
    "bin/dsh-discover-models.mjs",
    "profile/cordis.patch.yml",
    "profile/smelt-host.patch.yml",
    "profile/smelt-capabilities.patch.yml",
    "profile/smelt-discovery.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./profile/cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify-package": "node scripts/verify-package.mjs",
    "prepublishOnly": "npm run build && npm run typecheck && npm run test && npm run verify-package"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "1.3.0",
    "yaml": "2.8.1",
    "zod": "^3.25.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": "0.1.0-rc.8",
    "@deepseek-ai/dsh-agent": "0.1.0-rc.8",
    "@deepseek-ai/dsh-mcp-client": "0.1.0-rc.8",
    "@deepseek-ai/dsh-session-persistence": "0.1.0-rc.8"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "dsh-acp-rich": "bin/dsh-acp-rich.mjs",
    "dsh-credential": "bin/dsh-credential.mjs",
    "dsh-model-settings": "bin/dsh-model-settings.mjs",
    "dsh-model-capabilities": "bin/dsh-model-capabilities.mjs",
    "dsh-discover-models": "bin/dsh-discover-models.mjs"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    },
    "@deepseek-ai/dsh-session-persistence": {
      "optional": true
    }
  }
}
